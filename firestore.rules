rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "K6s09xCSP5WGaHLX990crsaOXYn1";
    }

    // Il sito legge pubblicamente solo il documento menu/current.
    // Solo l'account proprietario può crearlo o modificarlo.
    match /menu/current {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll(['menus', 'info', 'wa', 'phone', 'name', 'sub', 'tagline'])
        && request.resource.data.keys().hasOnly(['menus', 'info', 'wa', 'phone', 'name', 'sub', 'tagline'])
        && request.resource.data.menus is list
        && request.resource.data.menus.size() <= 10
        && request.resource.data.info is map
        && request.resource.data.wa is string
        && request.resource.data.phone is string
        && request.resource.data.name is string
        && request.resource.data.sub is string
        && request.resource.data.tagline is string;
      allow delete: if false;
    }

    // Ogni altro documento rimane inaccessibile.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
